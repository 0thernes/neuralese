{
 "name": "neuralese",
 "version": "17.3.0",
 "description": "NEURALESE: in-browser interpretability & weight-surgery lab for TinyStories-8M (GPT-Neo). Original engine code plus credited vendored third-party components (three.js, transformers.js/ONNX Runtime, WASM builds of Tsotchke Eshkol/Moonlab/QGTL/quantum_rng).",
 "main": "index.js",
 "scripts": {
  "test": "node --test test/*.test.mjs",
  "serve": "node tools/serve.mjs 8765 src",
  "smoke": "node test/smoke/engine-worker.smoke.mjs http://localhost:8765/",
  "smoke:ui": "node test/smoke/ui-refinement.smoke.mjs http://localhost:8765/",
  "smoke:core": "node test/smoke/core-ui.smoke.mjs http://localhost:8765/",
  "ref": ".venv/bin/python test/ref/ref.py",
  "wasm": "bash wasm/build-qrng.sh",
  "lint": "eslint . --max-warnings 100",
  "docs": "node tools/gendocs.mjs",
  "www": "node tools/build-www.mjs",
  "fetch-model": "node tools/fetch-model.mjs",
  "cli": "node src/cli.mjs --model model",
  "fetch-arch": "node tools/fetch-arch-models.mjs"
 },
 "keywords": [],
 "author": "Alex Donahue",
 "license": "MIT",
 "type": "module",
 "dependencies": {
  "puppeteer-core": "25.16.0"
 },
 "devDependencies": {
  "@capacitor/android": "7.6.9",
  "@capacitor/cli": "7.6.9",
  "@capacitor/core": "7.6.9",
  "@capacitor/ios": "7.6.9",
  "eslint": "9.39.5"
 }
}
