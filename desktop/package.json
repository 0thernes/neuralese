{
  "name": "neuralese-desktop",
  "productName": "Neuralese",
  "version": "13.0.0",
  "description": "Neuralese desktop app: in-browser interpretability and weight-surgery lab for TinyStories-8M",
  "homepage": "https://github.com/0thernes/neuralese",
  "author": { "name": "Alex Donahue", "email": "0thernes@users.noreply.github.com" },
  "license": "MIT",
  "main": "main.cjs",
  "desktopName": "neuralese.desktop",
  "scripts": {
    "prep": "node prep.cjs",
    "dist:linux": "node prep.cjs && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:win": "node prep.cjs && electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": { "electron": "^38.0.0", "electron-builder": "^26.0.0" },
  "build": {
    "appId": "io.github.othernes.neuralese",
    "productName": "Neuralese",
    "files": ["main.cjs", "www/**/*", "package.json"],
    "directories": { "output": "dist" },
    "linux": { "category": "Science", "maintainer": "Alex Donahue <0thernes@users.noreply.github.com>", "synopsis": "Interpretability lab for TinyStories-8M", "executableName": "neuralese", "syncDesktopName": true, "artifactName": "Neuralese-${version}-${arch}.${ext}" },
    "deb": { "packageName": "neuralese" },
    "win": { "artifactName": "Neuralese-${version}-${arch}-${target}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Neuralese-Setup-${version}-x64.${ext}" },
    "portable": { "artifactName": "Neuralese-${version}-x64-portable.${ext}" }
  }
}
